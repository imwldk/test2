# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 git 에서 제외됨)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# --- 아래는 모두 선택 (생략하면 괄호 안의 기본값) ---
# 접속 비밀번호. 값을 넣으면 비밀번호를 입력해야 번역기를 쓸 수 있다. 공개 URL 배포 시 권장 (없음 = 누구나 사용)
APP_PASSWORD=
# 입력 글자 수 한도 (2000)
MAX_INPUT_CHARS=2000
# 출력 토큰 상한. 0 이면 보내지 않음 (8000)
OPENAI_MAX_OUTPUT_TOKENS=8000
# reasoning.effort: low / medium / high / xhigh / max, 'none' 이면 파라미터를 보내지 않음 (low)
OPENAI_REASONING_EFFORT=low
# 호출 제한 시간(초), 실패 시 재시도 횟수 (30, 1)
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
# 남용/비용 방지: 세션 내 호출 간격(초), 세션당 최대 호출 수, 서버 전체 분당 최대 호출 수 (3, 50, 30)
MIN_INTERVAL_SECONDS=3
MAX_CALLS_PER_SESSION=50
GLOBAL_CALLS_PER_MINUTE=30
